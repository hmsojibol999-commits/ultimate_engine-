{
  // Verify field names against current Cloudflare docs before deploying (see DECISIONS D-005).
  "name": "shadow-grid",
  "main": "worker/index.ts",
  "compatibility_date": "2024-11-01",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*", "/s/*"]
  },
  "kv_namespaces": [
    // Run: npx wrangler kv namespace create SHARES  -> paste the id below.
    { "binding": "SHARES", "id": "REPLACE_WITH_KV_NAMESPACE_ID" }
  ],
  "ai": { "binding": "AI" },
  "vars": { "APP_NAME": "Shadow-Grid" }
}
